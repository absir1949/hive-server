# Hive Server Configuration

# Server port
PORT=3000

# VNC lease heartbeat timeout (ms, default 2 min)
VNC_LEASE_TTL_MS=120000

# Max concurrent Chrome containers (default 8). Extra starts evict the LRU idle browser.
MAX_RUNNING_BROWSERS=8

# Stop a browser with no VNC lease after this idle time (ms). 0 disables. Default 10 min.
IDLE_STOP_MS=600000

# Per-container cgroup limits (defaults: 1.5GiB RAM, 0.5 CPU). Passed through docker-compose.
CHROME_MEMORY_BYTES=1610612736
CHROME_NANO_CPUS=500000000

# Data directory on HOST (must be absolute path on Linux server)
# This is where profile data, extensions, and Chrome user-data-dirs live.
DATA_DIR=/opt/hive/data
